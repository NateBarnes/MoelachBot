# Required
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Optional: reactive posting (omit to disable)
MONITORED_CHANNELS=C01ABCDEF,C02GHIJKL
COOLDOWN_HOURS=48
RANDOM_DELAY_MAX_MINUTES=180

# Optional: scheduled posting (omit SCHEDULE_CHANNEL to disable)
SCHEDULE_CHANNEL=C01ABCDEF
SCHEDULE_DAY=wed
SCHEDULE_HOUR=10
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=America/Los_Angeles
